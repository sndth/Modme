#include "version.h"

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION MODME_VERSION_MAJOR, MODME_VERSION_MINOR, MODME_VERSION_PATCH, 0
PRODUCTVERSION MODME_VERSION_MAJOR, MODME_VERSION_MINOR, MODME_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Modme"
      VALUE "FileVersion", MODME_VERSION
      VALUE "LegalCopyright", "Copyright (c) 2026 sndth"
      VALUE "OriginalFilename", "Modme.asi"
      VALUE "ProductName", "Modme"
      VALUE "ProductVersion", MODME_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
